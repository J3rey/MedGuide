{
  "expo": {
    "name": "MedGuide",
    "slug": "medguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medguide.app"
    },

    "android": {
      "package": "com.medguide.app"
    },

    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MedGuide to access your camera to scan prescriptions."
        }
      ]
    ]
  }
}
